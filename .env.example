# Public browser RPC endpoints. Never put a secret-bearing URL in a VITE_* variable.
VITE_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
VITE_SOLANA_RPC_MAINNET=https://solana-rpc.publicnode.com

# Canonical origin baked into every launched coin's metadata URI. Set this to the
# production domain so a launch made from localhost or a preview deployment still
# points at production. Defaults to https://solana-firsts.pages.dev
VITE_METADATA_ORIGIN=https://solana-firsts.pages.dev
